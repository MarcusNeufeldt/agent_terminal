# Start with Kraken's demo environment.
KRAKEN_FUTURES_ENV=demo
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Hyperliquid native perpetuals: read-only, no signer/private key used.
# mainnet or testnet. Supply the actual master/subaccount, NOT an API-agent address.
HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_ACCOUNT_ADDRESS=

# Signed trading. Off unless this names testnet or mainnet. Both values below are
# then required. HYPERLIQUID_SECRET_KEY is an approved API-wallet key; it is read
# once at startup and never returned by any endpoint.
HYPERLIQUID_TRADING=off
HYPERLIQUID_SECRET_KEY=

PORT=8787
AI_CHAT_MODEL=google/gemini-3.8-flash
CHAT_CONTEXT_LIMIT=200000

# Comma-separated extra exact origins for a non-default Vite dev server.
VITE_DEV_ORIGINS=
# Exposes /api/debug/threads only when explicitly enabled.
TERMINAL_DEBUG=false
